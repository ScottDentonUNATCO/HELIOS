e-mode #walkControls .walkPad,
      .mobile-mode #walkControls .lookPad { grid-template-columns:repeat(2,64px); grid-template-rows:repeat(2,64px); gap:10px; }
      .mobile-mode #walkControls .walkPad button,
      .mobile-mode #walkControls .lookPad button,
      .mobile-mode #walkControls .walkActions button { width:64px; min-width:64px; height:64px; min-height:64px; }
      .mobile-mode #walkControls .walkActions { flex-direction:row; gap:12px; }
    }
    @media (prefers-reduced-motion:reduce) { .slip,.cameraToast { transition:none; } }
    .mobile-mode .cameraChip { top:max(92px,calc(env(safe-area-inset-top) + 92px)); right:max(8px,env(safe-area-inset-right)); font-size:6px; }
    .mobile-mode .cameraToast { bottom:max(104px,calc(env(safe-area-inset-bottom) + 104px)); max-width:92vw; overflow:hidden; text-overflow:ellipsis; }
    /* Paintball master toggle: when the options registry disables paintball, the
       shop and fire buttons hide and all paintball systems no-op (off = off). */
    .paintball-off #fireBtn, .paintball-off #walkFireBtn, .paintball-off #shopBtn { display:none !important; }
    .weekendFlow { grid-template-columns:repeat(3,1fr); }
    .weekendButton { margin-top:10px; background:#ffb42d; color:#101316; }
    .qualCard,.standingsCard { width:min(700px,100%); text-align:left; }
    .qualHead { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
    .qualRound { font:9px/1.5 "Press Start 2P",monospace; color:var(--cyan); }
    .qualMeta { margin:7px 0 0; color:var(--muted); font-size:11px; line-height:1.45; }
    .qualTrack { height:14px; margin:18px 0 14px; border:3px solid var(--line); background:#242a2d; overflow:hidden; }
    .qualProgress { height:100%; width:0; background:repeating-linear-gradient(90deg,var(--cyan) 0 38px,var(--yellow) 38px 76px); transition:width .3s steps(4,end); }
    .qualResults { max-height:42vh; overflow-y:auto; border-top:3px solid var(--line); border-bottom:3px solid var(--line); }
    .qualRow,.standingRow { display:grid; grid-template-columns:50px minmax(0,1fr) 92px; gap:8px; align-items:center; min-height:34px; padding:6px 8px; font:700 10px/1.3 "Roboto Mono",monospace; }
    .qualRow:nth-child(odd),.standingRow:nth-child(odd) { background:color-mix(in srgb,var(--cyan) 8%,transparent); }
    .qualRow.you,.standingRow.you { background:var(--yellow); color:#101316; }
    .qualRow span:last-child,.standingRow span:not(:nth-child(2)) { text-align:right; font-variant-numeric:tabular-nums; }
    .qualActions { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:14px; }
    .stageBanner { position:absolute; z-index:14; left:50%; top:44%; transform:translate(-50%,-50%); width:min(560px,92vw); padding:16px 18px; background:#ffe047f2; color:#101316; border:4px solid #101316; box-shadow:8px 8px 0 #000; text-align:center; pointer-events:none; }
    .stageBanner[hidden] { display:none !important; }
    .stageBanner strong { display:block; font:clamp(17px,5vw,30px)/1.25 "Press Start 2P",monospace; }
    .stageBanner span { display:block; margin-top:9px; font:700 11px/1.55 "Roboto Mono",monospace; }
    .standingsHead { display:flex; align-items:flex-end; justify-content:space-between; gap:14px; margin-bottom:12px; }
    .standingsMeta { color:var(--muted); font-size:10px; line-height:1.45; }
    .standingsList { max-height:55vh; overflow-y:auto; border:3px solid var(--line); }
    .standingRow { grid-template-columns:42px minmax(90px,1fr) 58px 46px 52px 48px; }
    .standingRow.header { position:sticky; top:0; z-index:1; background:var(--ink); color:var(--panel); font:8px/1.3 "Press Start 2P",monospace; }
    .standingRow.cutoff { border-bottom:4px solid var(--red); }
    .format-off .stageChoices { opacity:.42; pointer-events:none; }
    .playoff-off #standingsBtn,.playoff-off #menuStandingsBtn,.playoff-off #finishStandingsBtn,.playoff-off #mobileStandings { display:none !important; }
    @media (max-width:600px) {
      .weekendFlow { grid-template-columns:1fr; }
      .qualHead,.standingsHead { display:block; }
      .qualActions { grid-template-columns:1fr; }
      .standingRow { grid-template-columns:34px minmax(74px,1fr) 44px 34px 40px 34px; gap:4px; padding-inline:5px; font-size:8px; }
      .standingRow.header { font-size:6px; }
      .qualRow { grid-template-columns:38px minmax(0,1fr) 76px; font-size:9px; }
    }
    @media (prefers-reduced-motion:reduce) { .qualProgress { transition:none; } }
  </style>
</head>
<body>
<main class="game" id="game">
  <canvas id="track" aria-label="CHINASKAR stock car racing game with multiple cameras"></canvas>
  <div class="scanlines"></div>
  <div class="satTelemetry" id="venueReadout" aria-hidden="true"><span>CHINASKAR</span> · 印度 ⇄ 中国<br>DAYTONA GROTTO TRI-OVAL</div>

  <div class="hud" id="hud" hidden>
    <div class="meter">
      <div class="label">POSITION</div>
      <div class="value"><span id="pos">1</span><span style="font-size:11px"> / <span id="field">420</span></span></div>
      <div class="sub">LAP <span id="lap">1</span> / 100</div>
    </div>
    <div class="centerHud">
      <div class="flag" id="raceTime">00:00.0</div>
      <button class="mobileMenuBtn" id="mobileMenuBtn" aria-label="Open race controls" aria-expanded="false">RACE MENU</button>
      <button class="pause" id="pauseBtn" aria-label="Pause race">PAUSE</button>
      <button class="modeSwitch" id="modeBtn" aria-label="Switch between race car, tow truck, and walking">DRIVE: RACE CAR</button>
      <button class="viewSwitch" id="viewBtn" aria-label="Cycle Chase, Cockpit, 2.5D, Trackside, Helicopter, Blimp, Orbit, City Map, and Free cameras">VIEW: CHASE</button>
      <button class="viewSwitch" id="graphicsBtn" aria-label="Switch graphics mode">GFX: NES</button>
      <button class="viewSwitch" id="eraBtn" aria-label="Switch stock-car body era">BODY: 1990s</button>
      <button class="pitSwitch" id="pitBtn" aria-label="Request a pit stop">CALL PIT</button>
      <button class="viewSwitch" id="crtBtn" aria-label="Toggle CRT scanlines">CRT: ON</button>
      <button class="shopSwitch" id="shopBtn" aria-label="Open paintball shop">PAINT SHOP</button>
      <button class="viewSwitch" id="standingsBtn" aria-label="Open playoff standings">STANDINGS</button>
      <span class="pitStatus" id="pitStatus"></span>
      <span class="cameraReadout" id="cameraReadout">LOOK 0° · PITCH 0°</span>
    </div>
    <div class="meter right">
      <div class="label">SPEED</div>
      <div class="value"><span id="speed">0</span> <span style="font-size:10px">MPH</span></div>
      <div class="sub">TIRE SLIP</div>
      <div class="slipWrap"><div class="slip" id="slip"></div></div>
      <div class="sub"><span id="integrity">BODY 100%</span> · <span id="fuelState">FUEL SEALED</span></div>
    </div>
  </div>

  <aside class="diagnostics" id="diagnostics" aria-label="Performance diagnostics" hidden>
    <div class="diagnosticsGrid">
      <span>FPS</span><span id="diagFps">—</span>
      <span>FRAME</span><span id="diagFrame">— ms</span>
      <span>PHYSICS</span><span id="diagPhysics">— ms</span>
      <span>INPUT→FRAME EST.</span><span id="diagLatency">— ms</span>
      <span>ACTIVE CARS</span><span id="diagCars">0</span>
      <span>CAMERA</span><span id="diagCamera">MENU</span>
    </div>
    <canvas id="diagGraph" width="156" height="28" aria-label="Recent frame-time graph"></canvas>
  </aside>

  <div class="slipCue" id="slipCue" aria-hidden="true"></div>
  <div class="countdown" id="countdown"></div>
  <div class="hostCard hidden" id="hostCard" role="status" aria-live="polite">
    <div class="hosts">🐒 × 🐵</div>
    <div class="hostsTitle">SUN WUKONG &amp; HANUMAN</div>
    <div class="hostsQuote">"Greetings! The Monkey King of the East and the Monkey God of the South welcome you to CHINASKAR — American NASCAR where nobody can die! 420 cars. Zero funerals. Flattened by a stock car? Walk it off. Blown to bits? The ambulance puts you back together."</div>
    <div class="hostsCta">NOW — START YOUR DESTINIES!</div>
  </div>
  <div class="cameraChip" id="cameraChip" hidden>CAM · CHASE</div>
  <div class="cameraToast" id="cameraToast" role="status" aria-live="polite"></div>
  <div class="stageBanner" id="stageBanner" role="status" aria-live="assertive" hidden>
    <strong id="stageTitle">STAGE 1 COMPLETE</strong>
    <span id="stageSummary"></span>
  </div>

  <div class="touch" id="touchControls" aria-label="Touch driving controls">
    <div class="cluster steerCluster">
      <button data-key="left" aria-label="Steer left">◀</button>
      <button data-key="right" aria-label="Steer right">▶</button>
    </div>
    <div class="cluster lookCluster">
      <button class="cam" id="camLeft" aria-label="Look left">↶</button>
      <button class="cam" id="camCycle" aria-label="Next camera; hold on Trackside to toggle automatic cuts">CAM</button>
      <button class="cam" id="camRight" aria-label="Look right">↷</button>
    </div>
    <div class="cluster pedalCluster">
      <button class="fire" id="fireBtn" aria-label="Fire paintball"><span class="controlGlyph">F</span><span class="controlWord">FIRE</span></button>
      <button class="brake" data-key="brake" aria-label="Brake"><span class="controlGlyph">B</span><span class="controlWord">BRAKE</span></button>
      <button class="gas" data-key="gas" aria-label="Accelerate"><span class="controlGlyph">A</span><span class="controlWord">GAS</span></button>
    </div>
  </div>

  <div class="touch walkTouch" id="walkControls" aria-label="On-foot touch controls">
    <div class="walkPad" aria-label="Walk movement">
      <button class="forward" data-walk="forward" aria-label="Walk forward">▲</button>
      <button class="strafeLeft" data-walk="strafeLeft" aria-label="Strafe left">◀</button>
      <button class="back" data-walk="back" aria-label="Walk backward">▼</button>
      <button class="strafeRight" data-walk="strafeRight" aria-label="Strafe right">▶</button>
    </div>
    <div class="lookPad" aria-label="Camera look">
      <button class="lookUp" data-look="up" aria-label="Look up">⌃</button>
      <button class="lookLeft" data-look="left" aria-label="Look left">↶</button>
      <button class="lookDown" data-look="down" aria-label="Look down">⌄</button>
      <button class="lookRight" data-look="right" aria-label="Look right">↷</button>
    </div>
    <div class="cluster walkActions">
      <button class="cam" id="enterBtn" aria-label="Interact or enter nearby spare car"><span class="controlGlyph">E</span><span class="controlWord">INTERACT</span></button>
      <button class="fire" id="walkFireBtn" aria-label="Fire paintball"><span class="controlGlyph">F</span><span class="controlWord">FIRE</span></button>
    </div>
  </div>

  <section class="mobileSheet" id="mobileSheet" role="dialog" aria-modal="true" aria-label="Race controls" hidden>
    <div class="mobileSheetHead">
      <div><div class="mobileSheetTitle">ANDROID RACE CONTROL</div><div class="mobileSheetStatus" id="mobileQualityStatus">AUTO · 100%</div></div>
      <button class="mobileSheetClose" id="mobileSheetClose">DONE</button>
    </div>
    <div class="mobileGrid">
      <button class="accent" id="mobileCamera">CAMERA</button>
      <button id="mobileMode">VEHICLE</button>
      <button id="mobilePit">CALL PIT</button>
      <button id="mobileGraphics">GRAPHICS</button>
      <button id="mobileEra">BODY ERA</button>
      <button id="mobilePaint">PAINT SHOP</button>
      <button id="mobileStandings">STANDINGS</button>
      <button id="mobileQuality">QUALITY</button>
      <button id="mobileFullscreen">FULLSCREEN</button>
      <button class="danger" id="mobilePause">PAUSE</button>
      <button id="mobileRecenter">RECENTER</button>
    </div>
  </section>

  <section class="overlay" id="menu">
    <div class="card">
      <div class="stripe"></div>
      <h1>CHINASKAR</h1>
      <p class="tag">Draft through a hyper-massive Daytona-style tri-oval under the immortal city. Work pit road, survive the pack, recover wrecks, or leave the car for proper first-person paintball chaos.</p>
      <div class="hostStrip">🐒 <b>SUN WUKONG</b> × <b>HANUMAN</b> 🐵 HOST TONIGHT'S RACE — AMERICAN NASCAR, EAST &amp; SOUTH. EVERYONE IS IMMORTAL: NO FUNERALS, ONLY SLAPSTICK.</div>
      <div class="choiceTitle">PICK YOUR FIELD</div>
      <div class="choices">
        <button class="choice" data-cars="100"><strong>100</strong><small>FAST &amp; FERAL</small></button>
        <button class="choice selected" data-cars="420"><strong>420</strong><small>MAXIMUM CHIN</small></button>
      </div>
      <div class="rideRow" aria-label="Pick your car color">
        <span class="rideLabel">YOUR RIDE</span>
        <button class="ride selected" style="--ride:#00e8f3" data-color="#00e8f3" aria-label="Cyan car"></button>
        <button class="ride" style="--ride:#ffe047" data-color="#ffe047" aria-label="Yellow car"></button>
        <button class="ride" style="--ride:#f4473c" data-color="#f4473c" aria-label="Red car"></button>
        <button class="ride" style="--ride:#78d15e" data-color="#78d15e" aria-label="Green car"></button>
      </div>
      <div class="choiceTitle">PICK YOUR CIRCUIT</div>
      <div class="startFlow trackFlow">
        <button class="choice trackChoice selected" data-track="grotto"><strong>DAYTONA GROTTO</strong><small>GIANT TRI-OVAL · FULL FACILITY</small></button>
        <button class="choice trackChoice" data-track="moon"><strong>MOON TRI-OVAL</strong><small>LOW-G · CRATERS · EARTHRISE</small></button>
        <button class="choice trackChoice" data-track="daytona"><strong>DAYTONA · NODE 1</strong><small>2.5-MI TRI-OVAL · 31° BANKING</small></button>
        <button class="choice trackChoice" data-track="talladega"><strong>TALLADEGA · NODE 18</strong><small>2.66-MI TRI-OVAL · 33° BANKING</small></button>
        <button class="choice trackChoice" data-track="bristol"><strong>BRISTOL · NODE 33</strong><small>0.533-MI BULLRING · 24–30° BANKING</small></button>
        <button class="choice trackChoice" data-track="darlington"><strong>DARLINGTON · NODE 47</strong><small>1.366-MI EGG · THE LADY IN BLACK</small></button>
        <button class="choice trackChoice" data-track="charlotte"><strong>CHARLOTTE · NODE 72</strong><small>1.5-MI QUAD-OVAL · 24° BANKING</small></button>
        <button class="choice trackChoice" data-track="martinsville"><strong>MARTINSVILLE · NODE 101</strong><small>0.526-MI PAPERCLIP · FLAT</small></button>
      </div>
      <div class="choiceTitle">START FLOW</div>
      <div class="startFlow">
        <button class="choice startChoice selected" data-start="rolling"><strong>ROLLING</strong><small>PACE THEN GREEN</small></button>
        <button class="choice startChoice" data-start="staggered"><strong>STAGGERED</strong><small>SAFE GRID RELEASE</small></button>
      </div>
      <div class="choiceTitle">RACE DISTANCE</div>
      <div class="startFlow lapFlow">
        <button class="choice lapChoice" data-laps="3"><strong>3</strong><small>SPRINT</small></button>
        <button class="choice lapChoice selected" data-laps="12"><strong>12</strong><small>FEATURE</small></button>
        <button class="choice lapChoice" data-laps="100"><strong>100</strong><small>ENDURANCE</small></button>
      </div>
      <div class="choiceTitle">RACE WEEKEND · STAGE BREAKS</div>
      <div class="startFlow weekendFlow stageChoices" aria-label="Stage break fractions">
        <button class="choice stageChoice selected" data-stage="25-50"><strong>25 / 50%</strong><small>EARLY BREAKS</small></button>
        <button class="choice stageChoice" data-stage="33-67"><strong>33 / 67%</strong><small>EVEN THIRDS</small></button>
        <button class="choice stageChoice" data-stage="40-70"><strong>40 / 70%</strong><small>LONG FINISH</small></button>
      </div>
      <button class="start weekendButton" id="menuStandingsBtn">VIEW PLAYOFF STANDINGS</button>
      <div class="choiceTitle" style="margin-top:18px">STOCK-CAR BODY ERA</div>
      <div class="graphicsChoices bodyChoices" aria-label="Stock-car body era">
        <button class="gfxChoice bodyChoice" data-body-era="1970s"><strong>1970s</strong><small>COKE-BOTTLE</small></button>
        <button class="gfxChoice bodyChoice" data-body-era="1980s"><strong>1980s</strong><small>BOXY</small></button>
        <button class="gfxChoice bodyChoice selected" data-body-era="1990s"><strong>1990s</strong><small>ROUNDED</small></button>
      </div>
      <div class="choiceTitle" style="margin-top:18px">GRAPHICS MODE</div>
      <div class="graphicsChoices">
        <button class="gfxChoice selected" data-graphics="nes"><strong>NES</strong><small>8-BIT</small></button>
        <button class="gfxChoice" data-graphics="genesis"><strong>GENESIS</strong><small>16-BIT GRIT</small></button>
        <button class="gfxChoice" data-graphics="snes"><strong>SNES</strong><small>16-BIT GLOW</small></button>
        <button class="gfxChoice" data-graphics="n64"><strong>N64</strong><small>BOXY LOW-POLY</small></button>
        <button class="gfxChoice" data-graphics="ps1"><strong>PS1</strong><small>POLY JITTER</small></button>
        <button class="gfxChoice" data-graphics="ascii"><strong>ASCII</strong><small>NEON CITY</small></button>
      </div>
      <div class="choiceTitle qualityLabel">MOBILE PERFORMANCE</div>
      <div class="qualityChoices" aria-label="Mobile performance mode">
        <button class="qualityChoice selected" data-quality="auto">AUTO</button>
        <button class="qualityChoice" data-quality="high">HIGH</button>
        <button class="qualityChoice" data-quality="battery">BATTERY</button>
      </div>
      <button class="start" id="startBtn">DROP THE FLAG</button>
      <button class="start optOpenBtn" id="optBtn">⚙ OPTIONS</button>
      <p class="mobileHint">Touch mode turns on automatically on Android-sized screens. Big thumb controls, portrait HUD, drag-to-look FPS, adaptive resolution, and fullscreen are ready.</p>
      <p class="keys">Drive: WASD / ARROWS · SPACE brake · Q pit. On foot/fan: W/S move · A/D strafe · J/L/I/K look · E interact / enter a spare. T cycles race car, tow truck, driver, and fan. C / Shift+C cycles 9 distinct cameras · hold the camera control on Trackside for AUTO cuts · U/O zoom · X fire · P paint shop · G graphics · R restart.<br>Complete sprint, feature, or endurance races with drafting, cautions, timed service, rollover recovery, and a wreck-to-spare-car comeback loop.</p>
    </div>
  </section>

  <section class="overlay hidden" id="paintShop">
    <div class="card shopCard">
      <div class="stripe"></div>
      <h1 style="font-size:clamp(20px,5vw,34px)">PAINTBALL SHOP</h1>
      <p class="shopNote">Pick a hopper. Every loadout refills your paint and changes the shot pattern immediately.</p>
      <div class="shopGrid">
        <button class="shopItem selected" data-weapon="marker"><strong>MARKER</strong><small>240 rounds · straight shot</small></button>
        <button class="shopItem" data-weapon="rapid"><strong>RAPID</strong><small>360 rounds · fast stream</small></button>
        <button class="shopItem" data-weapon="scatter"><strong>SCATTER</strong><small>180 rounds · triple burst</small></button>
      </div>
      <div class="shopStatus" id="shopStatus">MARKER EQUIPPED · 240 PAINTBALLS</div>
      <button class="start" id="closeShop" style="margin-top:14px">BACK TO THE CHAOS</button>
    </div>
  </section>

  <section class="overlay hidden" id="options">
    <div class="card optCard">
      <div class="stripe"></div>
      <h1 style="font-size:clamp(20px,5vw,32px)">OPTIONS</h1>
      <p class="shopNote">Every system has a real switch. OFF means fully off: no spawning, no updating, no rendering, no sound. Gameplay choices save automatically; diagnostics starts OFF.</p>
      <div class="optList" id="optList" role="group" aria-label="Game system toggles"></div>
      <button class="start" id="closeOpts" style="margin-top:14px">BACK TO THE RACES</button>
    </div>
  </section>

  <section class="overlay hidden" id="qualifying" aria-label="Qualifying session">
    <div class="card qualCard">
      <div class="stripe"></div>
      <div class="qualHead">
        <div>
          <h1 style="font-size:clamp(20px,5vw,34px)">QUALIFYING</h1>
          <div class="qualRound" id="qualRound">ROUND 1 · GROUP RUNS</div>
          <p class="qualMeta" id="qualMeta">The full field runs in traffic-sized groups. Fast cars advance to the knockout rounds.</p>
        </div>
        <div class="optState" id="qualClock">--.---</div>
      </div>
      <div class="qualTrack"><div class="qualProgress" id="qualProgress"></div></div>
      <div class="qualResults" id="qualResults" aria-live="polite"></div>
      <div class="qualActions">
        <button class="start" id="qualSkip">SKIP TO GRID</button>
        <button class="start" id="qualContinue" hidden>START FROM GRID</button>
      </div>
    </div>
  </section>

  <section class="overlay hidden" id="standings" aria-label="Playoff standings">
    <div class="card standingsCard">
      <div class="stripe"></div>
      <div class="standingsHead">
        <div>
          <h1 style="font-size:clamp(20px,5vw,32px)">PLAYOFF TABLE</h1>
          <div class="standingsMeta" id="standingsMeta">SESSION CUP · 0 RACES</div>
        </div>
        <div class="optState">TOP 16</div>
      </div>
      <div class="standingsList" id="standingsList"></div>
      <div class="qualActions">
        <button class="start" id="resetStandings">RESET SESSION CUP</button>
        <button class="start" id="closeStandings">BACK TO THE RACES</button>
      </div>
    </div>
  </section>

  <section class="overlay hidden" id="handlingLab">
    <div class="card labCard">
      <div class="stripe"></div>
      <h1 style="font-size:clamp(20px,5vw,32px)">HANDLING LAB</h1>
      <p class="labIntro">Live player-car tuning. Changes take effect on the next physics tick; no race restart required. Defaults are the current shipping tune.</p>
      <div class="labList" id="handlingList"></div>
      <div class="labActions">
        <button class="start" id="resetHandling">RESET TO DEFAULTS</button>
        <button class="start" id="exportHandling">EXPORT TUNE</button>
      </div>
      <textarea class="labExport" id="handlingExport" readonly hidden aria-label="Exported handling tune"></textarea>
      <p class="labStatus" id="handlingStatus" aria-live="polite"></p>
      <button class="start" id="closeHandling">BACK TO OPTIONS</button>
    </div>
  </section>

  <section class="overlay hidden" id="paused">
    <div class="card">
      <div class="stripe"></div>
      <h1 style="font-size:clamp(24px,6vw,38px)">PIT STOP</h1>
      <p class="tag">The field is frozen. Your tires are not.</p>
      <button class="start" id="resumeBtn">BACK TO GREEN</button>
      <button class="start optOpenBtn" id="optBtn2">⚙ OPTIONS</button>
    </div>
  </section>

  <section class="overlay hidden" id="finish">
    <div class="card">
      <div class="stripe"></div>
      <h1 style="font-size:clamp(23px,6vw,38px)">CHECKERED!</h1>
      <div class="result" id="result"></div>
      <button class="start weekendButton" id="finishStandingsBtn">VIEW PLAYOFF STANDINGS</button>
      <button class="start" id="againBtn" style="margin-top:10px">NEW RACE WEEKEND</button>
    </div>
  </section>
</main>
<script>
(() => {
  'use strict';
  const canvas = document.getElementById('track');
  const ctx = canvas.getContext('2d');
  const ui = {
    menu:document.getElementById('menu'), paused:document.getElementById('paused'), finish:document.getElementById('finish'),
    hud:document.getElementById('hud'), countdown:document.getElementById('countdown'), pos:document.getElementById('pos'),
