(t);
  const enterBtn=document.getElementById('enterBtn');enterBtn.addEventListener('pointerdown',e=>{e.preventDefault();ensureAudio();enterBtn.classList.add('pressed');if(!interactOnFoot())tryEnterVehicle();});for(const ev of ['pointerup','pointercancel','pointerleave'])enterBtn.addEventListener(ev,e=>{e.preventDefault();enterBtn.classList.remove('pressed');});
  const walkFireBtn=document.getElementById('walkFireBtn');walkFireBtn.addEventListener('pointerdown',e=>{e.preventDefault();ensureAudio();keys.fire=true;walkFireBtn.classList.add('pressed');firePlayerPaintball();});for(const ev of ['pointerup','pointercancel','pointerleave'])walkFireBtn.addEventListener(ev,e=>{e.preventDefault();keys.fire=false;walkFireBtn.classList.remove('pressed');});
  window.CHINASKAR_CAMERA={set:setRaceCamera,cycle:cycleCamera,list:()=>[...cameraModes],current:()=>cameraMode};
  window.CHINASKAR_BODY={set:applyBodyEra,cycle:toggleBodyEra,current:()=>selectedBodyEra};
})();
</script>

